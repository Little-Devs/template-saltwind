---
import { site } from '../data/site';

const { stay } = site;
---

<section id="stay" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="kicker text-rust">{stay.kicker}</p>
      <h2 class="mt-4 font-display text-4xl leading-tight md:text-5xl">{stay.title}</h2>
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-2">
      <div>
        <h3 class="kicker text-ink/60">Rates by season</h3>
        <ul class="mt-5">
          {
            stay.rates.rows.map((row) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-ink/15 py-4 first:border-t">
                <span class="font-display text-2xl">{row.season}</span>
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-ink/50">{row.dates}</span>
                <span class="font-display text-xl text-rust">{row.range}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-ink/60">{stay.rates.note}</p>
      </div>

      <div>
        <h3 class="kicker text-ink/60">House rules</h3>
        <ul class="mt-5 space-y-3.5">
          {
            stay.rules.map((rule) => (
              <li class="flex items-start gap-3">
                <span class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 bg-rust" aria-hidden="true" />
                <span class="leading-relaxed text-ink/80">{rule}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 border border-ink/20 bg-foam px-5 py-4">
          <p class="font-display text-lg italic text-kelp">
            No booking engine — write to us and we reply within a day.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
