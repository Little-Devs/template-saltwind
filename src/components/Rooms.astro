---
import { site } from '../data/site';

const { rooms } = site;

type Side = 'top' | 'left' | 'right' | 'bottom';
interface Rect {
  x: number;
  y: number;
  w: number;
  h: number;
}
interface Line {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
}

const R = { x: 10, y: 10, w: 120, h: 90 };

function planFor(side: Side): { bed: Rect; pillow: Line; window: Line } {
  const bw = 46;
  const bd = 22;
  const m = 8;
  if (side === 'top') {
    const bed = { x: R.x + (R.w - bw) / 2, y: R.y + m, w: bw, h: bd };
    return {
      bed,
      pillow: { x1: bed.x + 5, y1: bed.y + 7, x2: bed.x + bed.w - 5, y2: bed.y + 7 },
      window: { x1: R.x + 38, y1: R.y + R.h, x2: R.x + 82, y2: R.y + R.h },
    };
  }
  if (side === 'bottom') {
    const bed = { x: R.x + (R.w - bw) / 2, y: R.y + R.h - bd - m, w: bw, h: bd };
    return {
      bed,
      pillow: { x1: bed.x + 5, y1: bed.y + bed.h - 7, x2: bed.x + bed.w - 5, y2: bed.y + bed.h - 7 },
      window: { x1: R.x + 38, y1: R.y, x2: R.x + 82, y2: R.y },
    };
  }
  if (side === 'left') {
    const bed = { x: R.x + m, y: R.y + (R.h - bw) / 2, w: bd, h: bw };
    return {
      bed,
      pillow: { x1: bed.x + 7, y1: bed.y + 5, x2: bed.x + 7, y2: bed.y + bed.h - 5 },
      window: { x1: R.x + R.w, y1: R.y + 26, x2: R.x + R.w, y2: R.y + 64 },
    };
  }
  const bed = { x: R.x + R.w - bd - m, y: R.y + (R.h - bw) / 2, w: bd, h: bw };
  return {
    bed,
    pillow: { x1: bed.x + bed.w - 7, y1: bed.y + 5, x2: bed.x + bed.w - 7, y2: bed.y + bed.h - 5 },
    window: { x1: R.x, y1: R.y + 26, x2: R.x, y2: R.y + 64 },
  };
}
---

<section id="rooms" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="kicker text-rust">{rooms.kicker}</p>
      <h2 class="mt-4 font-display text-4xl leading-tight md:text-5xl">{rooms.title}</h2>
      <p class="mt-5 leading-relaxed text-ink/70">{rooms.intro}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        rooms.items.map((room, index) => {
          const p = planFor(room.bed as Side);
          return (
            <article class="group border border-ink/15 bg-foam transition-transform duration-300 hover:-translate-y-1">
              <div class={`room-field grain relative aspect-[4/3] overflow-hidden field-${room.tone}`}>
                <span class="absolute left-4 top-3 z-10 text-[0.62rem] font-semibold uppercase tracking-[0.28em] opacity-70">
                  Room {index + 1}
                </span>
                <svg
                  class="room-plan plan absolute bottom-3 right-3 w-28 opacity-80 transition-transform duration-300 group-hover:scale-105"
                  viewBox="0 0 140 110"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <rect x={R.x} y={R.y} width={R.w} height={R.h} rx="1" />
                  <rect x={p.bed.x} y={p.bed.y} width={p.bed.w} height={p.bed.h} rx="1" fill="currentColor" fill-opacity="0.14" />
                  <line x1={p.pillow.x1} y1={p.pillow.y1} x2={p.pillow.x2} y2={p.pillow.y2} stroke-opacity="0.7" />
                  <line x1={p.window.x1} y1={p.window.y1} x2={p.window.x2} y2={p.window.y2} stroke-dasharray="4 3" />
                  <path d="M 10 34 A 24 24 0 0 1 34 10" stroke-opacity="0.5" />
                </svg>
              </div>
              <div class="p-5">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-display text-2xl">{room.name}</h3>
                  <span class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-rust">{room.kind}</span>
                </div>
                <p class="mt-1 text-xs font-medium uppercase tracking-[0.14em] text-ink/50">{room.aspect}</p>
                <p class="mt-3 text-sm leading-relaxed text-ink/70">{room.note}</p>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="mt-8 font-display text-xl italic text-ink/60">{rooms.note}</p>
  </div>
</section>
