---
import { site } from '../data/site';

const links = site.nav.filter((item) => site.sections[item.section]);
---

<footer class="bg-ink text-salt">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="flex items-baseline gap-3">
          <span class="flex h-9 w-9 items-center justify-center bg-foam font-display text-lg leading-none text-ink">
            {site.logo.mark}
          </span>
          <span class="font-display text-2xl leading-none text-foam">{site.logo.text}</span>
        </p>
        <p class="mt-4 max-w-[34ch] text-sm text-salt/70">{site.footer.tagline}</p>
        <p class="mt-4 font-display text-xl italic text-foam/90">{site.place}</p>
      </div>

      <nav aria-label="Footer" class="text-sm">
        <ul class="space-y-2.5">
          {
            links.map((item) => (
              <li>
                <a class="text-salt/75 transition-colors hover:text-rust" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="text-sm text-salt/75">
        <p>
          <a class="hover:text-rust" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
        <p>
          <a class="hover:text-rust" href={site.contact.phoneHref}>{site.contact.phone}</a>
        </p>
        <p class="mt-2 leading-relaxed">{site.contact.address}</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-foam/15 pt-6 text-xs text-salt/50 sm:flex-row sm:items-center sm:justify-between">
      <p>{site.footer.legal}</p>
      <p>{site.footer.credit}</p>
    </div>
  </div>
</footer>
