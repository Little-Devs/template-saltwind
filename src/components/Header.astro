---
import { site } from '../data/site';

const links = site.nav.filter((item) => site.sections[item.section]);
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-salt/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 md:py-4">
    <a href="#top" class="flex items-baseline gap-3">
      <span class="flex h-9 w-9 items-center justify-center bg-kelp font-display text-lg leading-none text-foam">
        {site.logo.mark}
      </span>
      <span class="font-display text-2xl leading-none">{site.logo.text}</span>
      <span class="hidden text-[0.62rem] font-semibold uppercase tracking-[0.28em] text-ink/50 sm:inline">
        {site.logo.sub}
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm font-medium">
        {
          links.map((item) => (
            <li>
              <a class="transition-colors hover:text-rust" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="border border-ink/25 px-3.5 py-1.5 text-sm font-semibold tracking-wide hover:border-rust hover:text-rust md:hidden"
    >
      Menu
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Primary, mobile" class="hidden border-t border-ink/10 bg-salt px-5 pb-6 pt-2 md:hidden">
    <ul>
      {
        links.map((item) => (
          <li class="border-b border-ink/10 last:border-b-0">
            <a class="block py-3 font-display text-2xl" href={item.href}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    panel?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(panel?.classList.contains('hidden') ?? false);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
