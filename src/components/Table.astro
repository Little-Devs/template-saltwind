---
import { site } from '../data/site';

const { table } = site;
---

<section id="table" class="scroll-mt-20 border-y border-ink/10 bg-foam">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="kicker text-rust">{table.kicker}</p>
      <h2 class="mt-4 font-display text-4xl leading-tight md:text-5xl">{table.title}</h2>
      <p class="mt-5 leading-relaxed text-ink/70">{table.intro}</p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-5">
      <aside class="lg:col-span-2">
        <div class="border border-ink/20 bg-salt p-6">
          <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-ink/60">How it runs</h3>
          <dl class="mt-5">
            {
              table.service.map((row) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-ink/20 py-3 last:border-b-0">
                  <dt class="text-sm font-semibold">{row.label}</dt>
                  <dd class="text-right text-sm text-ink/70">{row.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-5 font-display text-lg italic text-kelp">The kettle stays on the landing all day.</p>
        </div>
      </aside>

      <div class="lg:col-span-3">
        <ul>
          {
            table.plates.map((plate, index) => (
              <li class="flex items-baseline gap-6 border-b border-ink/15 py-5 first:border-t">
                <span class="font-display text-lg text-rust">{String(index + 1).padStart(2, '0')}</span>
                <div class="flex flex-1 flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3 class="font-display text-2xl">{plate.title}</h3>
                  <p class="max-w-[38ch] text-sm text-ink/65">{plate.note}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
